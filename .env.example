# Copy to .env and fill in. Never commit .env.
# VITE_* values are inlined into the CLIENT bundle at build time and are public.

# ---------- Supabase (your own project) ----------
SUPABASE_URL="https://YOUR_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://YOUR_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server only. NEVER prefix with VITE_. Bypasses RLS entirely.
# Nothing on the app's critical path needs this; it's used by the legacy admin
# functions and the in-app demo seeder.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------- AI (optional; features degrade cleanly without it) ----------
# Any OpenAI-compatible endpoint: OpenAI, Azure, OpenRouter, Groq, vLLM…
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL="gpt-4o"                  # PDF scorecard extraction

# ---------- Voice transcription (optional) ----------
# Any Whisper-compatible endpoint. Prefer a vendor you hold a BAA with.
WHISPER_API_KEY=""
WHISPER_BASE_URL="https://api.openai.com/v1"
WHISPER_MODEL="whisper-1"

# ---------- One-click demo link ----------
# Set DEMO_MODE=1 to enable /demo, which auto-signs-in the account below.
# Send someone https://your-app/demo and they are straight in — no signup.
# The password is SERVER-side only and never reaches the client bundle.
# Turn this OFF on anything holding real data.
DEMO_MODE="0"
DEMO_EMAIL="elena.vasquez@rnr-demo.org"
DEMO_PASSWORD="DemoRnR!2026"

# ---------- Security ----------
CSP_ENFORCE="0"                           # 1 to enforce instead of report-only
VITE_IDLE_TIMEOUT_MINUTES="20"            # automatic logoff; 0 disables (dev only)
VITE_ERROR_ENDPOINT=""                    # optional POST target for client errors
